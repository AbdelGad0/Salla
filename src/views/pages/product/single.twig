{% extends 'layouts.master' %}
{% block title %}تفاصيل المنتج | موبايلاتي{% endblock %}
{% block content %}
<section class="max-w-5xl mx-auto px-4 py-12 grid md:grid-cols-2 gap-8">
  <img src="src/assets/images/iphone-14.jpg" class="rounded-3xl w-full h-96 object-cover" alt="product" />
  <div>
    <h1 class="text-2xl font-extrabold mb-2">آيفون 15 برو 256GB</h1>
    <p class="text-green-700 font-extrabold text-2xl mb-4">5,299 ر.س</p>
    <p class="text-gray-600 text-sm leading-7 mb-6">شاشة 6.1 بوصة، شريحة A17 Pro، كاميرا 48MP، ضمان سنتين، شحن مجاني وإرجاع خلال 14 يوم.</p>
    <button data-add="iphone15" class="bg-green-600 text-white font-bold px-8 py-3 rounded-xl">أضف للسلة</button>
  </div>
</section>
{% endblock %}
