<div id="cart-drawer" class="translate-x-full fixed top-0 bottom-0 start-0 w-full max-w-sm bg-white shadow-2xl z-50 flex flex-col">
  <div class="flex items-center justify-between p-4 border-b">
    <p class="font-extrabold" data-ar="سلة التسوق" data-en="Shopping cart">سلة التسوق</p>
    <button id="cart-close" class="border rounded-xl px-3 py-1">✕</button>
  </div>
  <div id="cart-items" class="flex-1 overflow-auto p-4 flex flex-col gap-3"></div>
  <div class="p-4 border-t">
    <div class="flex justify-between font-extrabold mb-3">
      <span data-ar="الإجمالي" data-en="Total">الإجمالي</span>
      <span id="cart-total" class="text-green-700">0 ر.س</span>
    </div>
    <button class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-xl" data-ar="إتمام الطلب" data-en="Checkout">إتمام الطلب</button>
  </div>
</div>
<div id="cart-overlay"></div>
