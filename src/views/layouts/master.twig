<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}متجر موبايلات | Salla Mobiles{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="{{ 'src/assets/styles/app.css' }}" />
</head>
<body class="bg-gray-50 text-gray-800">
  {% include 'components.header.header' %}
  <main>{% block content %}{% endblock %}</main>
  {% include 'components.footer.footer' %}
  {% include 'components.home.cart-drawer' %}

  <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-5 py-2.5 rounded-xl text-sm font-bold z-50"></div>

  {# Twilight SDK يُحقن تلقائياً داخل سلة عبر هذا الـ hook #}
  {% hook 'body:end' %}
  <script src="{{ 'src/assets/js/app.js' }}" type="module"></script>
</body>
</html>
